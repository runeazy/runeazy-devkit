{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "extra-files": [
        { "type": "json", "path": "packages/devkit-checks/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/devkit-eslint/package.json", "jsonpath": "$.version" },
        {
          "type": "json",
          "path": "packages/devkit-prettier/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/devkit-tsconfig/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/devkit-commitlint/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
