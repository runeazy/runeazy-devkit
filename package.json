{
  "name": "runeazy-devkit",
  "version": "0.1.0",
  "private": true,
  "description": "RunEazy's shared tooling: checks, configs and the Renovate preset",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --check .",
    "cloud-terms": "node packages/devkit-checks/src/cli.mjs cloud-terms",
    "dependency-rule": "node packages/devkit-checks/src/cli.mjs dependency-rule"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.0"
  }
}
